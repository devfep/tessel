{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tessel-steward",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "observability": { "enabled": true },
  // Cloudflare Access sign-in for /dashboard and /review (application tessel-dashboard). The team
  // domain and AUD tag are not secret; they are committed because `wrangler deploy` overwrites
  // vars set in the dashboard. Viewers are the emails allowed through.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "fepdev.cloudflareaccess.com",
    "ACCESS_AUD": "81ae313c892cf190f69330a71a9b0f600aa31e340d43a8dcd54eb629dfd33b08",
    "DASHBOARD_VIEWERS": "devfep@gmail.com",
  },
  "services": [{ "binding": "COORDINATOR", "service": "tessel-coordinator" }],
  "secrets": { "required": ["STEWARD_ADMIN_TOKEN", "IDENTITY_SIGNING_KEY"] },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "tessel" }],
  "queues": {
    "consumers": [
      { "queue": "tessel-artifacts-events", "max_batch_size": 10, "max_batch_timeout": 1 },
    ],
  },
  "containers": [
    {
      "class_name": "TestRunner",
      "scheduling_policy": "durable_object",
      "images": {
        // Repos without a tessel.toml: Node only, small enough for a `lite` instance (2 GB disk).
        "tests": { "dockerfile": "./Dockerfile" },
        // Repos with a tessel.toml: Rust, Node, pnpm and baked dependencies. Built from the
        // repository root, which holds the lockfiles it bakes in.
        "toolchain": { "dockerfile": "./toolchain.Dockerfile", "build_context": ".." },
      },
    },
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "TestRunner", "name": "TEST_RUNNER" }],
  },
  "exports": {
    "TestRunner": { "type": "durable-object", "storage": "sqlite" },
  },
}
